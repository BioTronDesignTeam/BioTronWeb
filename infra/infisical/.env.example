# Copy outside the repository to /etc/biotron/infisical/bootstrap.env, mode 0600.
# Generate separately: openssl rand -hex 16
ENCRYPTION_KEY=
# Generate separately: openssl rand -base64 32
AUTH_SECRET=
# Generate separately: openssl rand -hex 32 (URI-safe; no URL escaping needed)
INFISICAL_DB_PASSWORD=
INFISICAL_SITE_URL=http://localhost:8090
INFISICAL_PORT=8090
INFISICAL_IMAGE=infisical/infisical:v0.166.2
