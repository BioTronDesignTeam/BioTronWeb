# One instance's hostnames. 40-biotron-sites.sh renders this once per entry in
# EDGE_SITES, filling INSTANCE, BASE_DOMAIN, and ROBOTS. Upstreams use the
# instance-qualified aliases each app carries on its instance's network,
# which Nginx joins. They are resolved per request, so a stopped instance
# answers 502 without keeping Nginx or another instance from starting.

server {
    listen 8080;
    server_name ${BASE_DOMAIN};

    include /etc/nginx/snippets/edge-health.conf;
    ${ROBOTS}

    location / {
        set $frontend http://${INSTANCE}-site-web:80;
        proxy_pass $frontend;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

server {
    listen 8080;
    server_name www.${BASE_DOMAIN};

    include /etc/nginx/snippets/edge-health.conf;
    ${ROBOTS}

    location / {
        return 308 https://${BASE_DOMAIN}$request_uri;
    }
}

server {
    listen 8080;
    server_name calendar.${BASE_DOMAIN};

    include /etc/nginx/snippets/edge-health.conf;
    ${ROBOTS}

    location = /api {
        return 308 /api/;
    }

    location /api/ {
        set $backend http://${INSTANCE}-calendar-api:8080;
        rewrite ^/api/?(.*)$ /$1 break;
        proxy_pass $backend;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location /feeds/ {
        set $backend http://${INSTANCE}-calendar-api:8080;
        proxy_pass $backend;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location / {
        set $frontend http://${INSTANCE}-calendar-web:80;
        proxy_pass $frontend;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

