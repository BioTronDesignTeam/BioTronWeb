# Copy this file to .env beside it. ./launch reads it; plain docker compose
# run from the repository root does not.
# The edge has its own file: see edge/.env.example.

# -----------------------------------------------------------------------------
# PostgreSQL credentials and host port
# -----------------------------------------------------------------------------
POSTGRES_USER=biotron
POSTGRES_PASSWORD=change-me
POSTGRES_DB=biotron
POSTGRES_PORT=5432
# Password for sprinter_reader, the read-only role Sprinter uses for logger and oauth.
SPRINTER_READER_PASSWORD=change-me-reader
# Each app's own login role, with rights in its own schema only
# (postgres/init/05-app-roles.sh). Each app's .env names its role's password in
# DATABASE_URL. Left empty, that role is not made and the app must use the
# owner's URL instead.
AUTH_DB_PASSWORD=change-me-auth
CALENDAR_DB_PASSWORD=change-me-calendar
STATUS_DB_PASSWORD=change-me-status
SPRINTER_DB_PASSWORD=change-me-sprinter
