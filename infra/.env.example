# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Edge routing and Cloudflare Tunnel
# Store the tunnel token in the referenced file, never directly in .env.
# -----------------------------------------------------------------------------
BASE_DOMAIN=biotron-dev.com
CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/biotron/secrets/cloudflare-tunnel-token
NGINX_IMAGE=biotron-edge-nginx:local

# -----------------------------------------------------------------------------
# PostgreSQL credentials and host port
# -----------------------------------------------------------------------------
POSTGRES_USER=biotron
POSTGRES_PASSWORD=change-me
POSTGRES_DB=biotron
POSTGRES_PORT=5432
# Password for sprinter_reader, the read-only role Sprinter uses for logger and oauth.
SPRINTER_READER_PASSWORD=change-me-reader

# -----------------------------------------------------------------------------
# Redis host port
# -----------------------------------------------------------------------------
REDIS_PORT=6379
