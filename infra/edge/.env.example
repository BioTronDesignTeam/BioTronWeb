# For testing the edge on one machine only: copy to infra/edge/.env. A host
# keeps these in /etc/biotron/edge.env, root-only, mode 0600.
# <instance>=<domain>[:noindex] pairs, space separated. A laptop instance is
# `local`. A host: EDGE_SITES="staging=uwbiotron.dev:noindex prod=uwbiotron.ca"
EDGE_SITES=local=localhost
# Never start the tunnel on a laptop; use ./launch edge --no-tunnel there.
CLOUDFLARE_TUNNEL_TOKEN=
