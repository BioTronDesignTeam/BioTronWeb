#!/usr/bin/env bash
# Starts and stops the platform with Docker Compose, so nobody has to remember
# which compose file takes which flags. It never edits secrets or removes volumes.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: ./launch <target> [options]

Targets
  infra     Postgres and Redis
  web       The apps: site, calendar, auth, exo, logger, sprinter
  all       infra, then web
  edge      The edge Nginx and the Cloudflare tunnel (not part of all)
  secrets   Independent Infisical stack (not part of all)
  stop      Stop containers and keep their data:
            ./launch stop [infra|web|all|edge|secrets]
  status    Show every BioTron container

Options
  --runtime      Ignore repo .env files; use injected process variables.
  --build        Rebuild images first. Needed after a pull or a VITE_* change.
  --no-<app>     Leave an app out of web, for example --no-sprinter. Repeatable.
  --no-tunnel    edge only: start Nginx and leave the tunnel closed.
  --dry-run      Print the docker commands and run nothing.
  --help         Show this help.

Examples
  ./launch infra
  ./launch web --no-sprinter --build
  ./launch all --build
  ./launch edge --no-tunnel --build
  ./launch stop web

A laptop needs only infra and web; never start the tunnel there. The edge reads
infra/edge/.env when it exists, otherwise /etc/biotron/edge.env.
Migrations need no step of their own. Each app's *-migrate container applies
what is pending and exits before that app's API starts.
USAGE
}

root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
cd "$root"

apps='site calendar auth exo logger sprinter'
target='' build=false tunnel=true dry_run=false excluded='' stop_target='all' runtime=false

die() { echo "launch: $*" >&2; exit 1; }
is_app() { case " $apps " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

[[ $# -gt 0 ]] || { usage; exit 1; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --build) build=true ;;
    --runtime) runtime=true ;;
    --no-tunnel) tunnel=false ;;
    --dry-run) dry_run=true ;;
    --no-*)
      app=${1#--no-}
      is_app "$app" || die "unknown app '$app' in $1. Apps: $apps"
      excluded="$excluded $app" ;;
    -*) die "unknown option $1. Try ./launch --help" ;;
    infra|web|all|edge|status|secrets)
      [[ -z $target ]] || { [[ $target == stop ]] && stop_target=$1 || die "one target at a time: got '$target' and '$1'"; }
      [[ -n $target ]] || target=$1 ;;
    stop)
      [[ -z $target ]] || die "one target at a time: got '$target' and 'stop'"
      target=stop ;;
    *) die "unknown target '$1'. Try ./launch --help" ;;
  esac
  shift
done
[[ -n $target ]] || die 'name a target: infra, web, all, edge, secrets, stop, or status'
[[ $stop_target != status ]] || die "'status' cannot be stopped"
if [[ -n $excluded && $target != web && $target != all ]]; then die '--no-<app> only applies to web and all'; fi
if ! $tunnel && [[ $target != edge ]]; then die '--no-tunnel only applies to edge'; fi

command -v docker >/dev/null 2>&1 || die 'docker is not installed or not on PATH'

# Prints the command, then runs it unless this is a dry run.
run() {
  printf '+'; printf ' %q' "$@"; printf '\n'
  $dry_run || "$@"
}

# Runtime mode also disables Compose's implicit root .env lookup.
if $runtime; then
  export COMPOSE_DISABLE_ENV_FILE=true
fi
# Include env_file does not support required:false. Select existing local
# files explicitly, otherwise use /dev/null so no app file is required.
for app in $apps; do
  env_file=/dev/null
  if ! $runtime && [[ -f apps/$app/.env ]]; then env_file="$root/apps/$app/.env"; fi
  env_key=$(printf '%s' "$app" | tr '[:lower:]' '[:upper:]')
  export "${env_key}_ENV_FILE=$env_file"
done
infra_compose() {
  local env_file=/dev/null
  if ! $runtime && [[ -f infra/.env ]]; then env_file=infra/.env; fi
  run docker compose -f infra/docker-compose.yml --env-file "$env_file" "$@"
}
# The edge's settings and tunnel token are bootstrap configuration, kept in a
# root-only file outside the checkout. A local infra/edge/.env wins outside
# runtime mode, for testing the edge on a laptop.
edge_compose() {
  local env_file=${EDGE_ENV_FILE:-/etc/biotron/edge.env}
  if [[ -z ${EDGE_ENV_FILE:-} ]] && ! $runtime && [[ -f infra/edge/.env ]]; then env_file=infra/edge/.env; fi
  run docker compose -f infra/edge/docker-compose.yml --env-file "$env_file" "$@"
}
secrets_compose() {
  run docker compose -f infra/infisical/docker-compose.yml --env-file "${INFISICAL_BOOTSTRAP_FILE:-/etc/biotron/infisical/bootstrap.env}" "$@"
}

# The networks are external to every compose file, so infra, the apps, and the
# edge can start in any order. Creating one is the only state launch adds.
ensure_network() {
  if $dry_run || ! docker network inspect "$1" >/dev/null 2>&1; then
    printf '+ docker network create %q\n' "$1"
    $dry_run || docker network create "$1" >/dev/null
  fi
}

# Check only selected services, without printing the rendered credentials.
validate_web() {
  command -v jq >/dev/null 2>&1 || die 'jq is required to validate app configuration'
  docker compose config --format json | jq -er --arg selected "$1" '
    .services as $services |
    ($selected | split("\n"))[] as $name |
    $services[$name].environment as $env |
    if ($env | has("DATABASE_URL")) and (($env.DATABASE_URL // "") == "") then
      error($name + ": set its app-prefixed DATABASE_URL")
    elif $name == "logger-api" and (($env.LOGGER_INGEST_TOKEN // "") == "") then
      error("logger-api: set LOGGER_INGEST_TOKEN")
    else true end
  ' >/dev/null
}

# The services of the chosen apps, read from the compose file itself so a new
# service is picked up with no edit here. An app's services share its prefix:
# calendar-migrate, calendar-api, calendar-web.
web_services() {
  local service app skip
  docker compose config --services | sort | while read -r service; do
    skip=false
    for app in $excluded; do
      case "$service" in "$app"-*) skip=true ;; esac
    done
    $skip || echo "$service"
  done
}

start_infra() {
  ensure_network biotron
  local args=(up -d)
  $build && args+=(--build)
  infra_compose "${args[@]}"
}

start_web() {
  local services
  services=$(web_services)
  [[ -n $services ]] || die 'every app was left out, so there is nothing to start'
  validate_web "$services"
  ensure_network biotron
  local args=(up -d)
  $build && args+=(--build)
  # shellcheck disable=SC2086
  run docker compose "${args[@]}" $services
}

start_edge() {
  ensure_network biotron
  local args=(up -d)
  $build && args+=(--build)
  $tunnel || args+=(nginx)
  edge_compose "${args[@]}"
}

stop_web() { run docker compose stop; }
stop_infra() { infra_compose stop; }

case "$target" in
  secrets)
    args=(up -d)
    $build && die 'Infisical uses prebuilt images; --build does not apply'
    secrets_compose "${args[@]}" ;;
  infra) start_infra ;;
  web) start_web ;;
  all) start_infra; start_web ;;
  edge) start_edge ;;
  status) run docker ps -a --filter name=biotron --format 'table {{.Names}}\t{{.Status}}' ;;
  stop)
    # Apps first, so nothing is left talking to a database that has gone.
    case "$stop_target" in
      secrets) secrets_compose stop ;;
      edge) edge_compose stop ;;
      web) stop_web ;;
      infra) stop_infra ;;
      all) stop_web; stop_infra ;;
    esac ;;
esac
