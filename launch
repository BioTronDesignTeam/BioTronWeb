#!/usr/bin/env bash
# Starts and stops the platform with Docker Compose, so nobody has to remember
# which compose file takes which flags. It never edits secrets or removes volumes.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: ./launch <target> [options]

Targets
  infra     Postgres
  web       The apps: biotron, calendar, auth, exogui, sprinter
  all       infra, then web
  edge      The edge Nginx and the Cloudflare tunnel (not part of all)
  secrets   Independent Infisical stack (not part of all)
  stop      Stop containers and keep their data:
            ./launch stop [infra|web|all|edge|secrets]
  status    Show every BioTron container

Options
  --instance <name>
                 Run infra and web as the named instance, such as staging or
                 prod: Compose project biotron-<name>, network biotron-<name>,
                 volumes of its own, and no host ports. Without it the
                 project is biotron.
  --runtime      Ignore repo .env files; use injected process variables.
  --build        Rebuild images first. Needed after a pull or a VITE_* change.
  --pull         Pull the images IMAGE_REGISTRY and IMAGE_TAG name and never
                 build, as a host does when it deploys a commit. With all, also
                 remove containers of services that no longer exist.
  --no-<app>     Leave an app out of web, for example --no-sprinter. Repeatable.
  --no-tunnel    edge only: start Nginx and leave the tunnel closed.
  --dry-run      Print the docker commands and run nothing.
  --help         Show this help.

Examples
  ./launch infra
  ./launch web --no-sprinter --build
  ./launch all --build
  ./launch all --instance staging --runtime
  ./launch edge --no-tunnel --build
  ./launch stop web

A laptop needs only infra and web; never start the tunnel there. The edge reads
infra/edge/.env when it exists, otherwise /etc/biotron/edge.env.
Migrations need no step of their own. Each app's *-migrate container applies
what is pending and exits before that app's API starts.
USAGE
}

root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
cd "$root"

apps='biotron calendar auth exogui sprinter'
# postgres-roles is a one-shot that brings the database roles up to date
# before any migration; see infra/postgres/init.
infra_services='postgres postgres-roles'
target='' build=false pull=false tunnel=true dry_run=false excluded='' stop_target='all' runtime=false instance=''

die() { echo "launch: $*" >&2; exit 1; }
is_app() { case " $apps " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

[[ $# -gt 0 ]] || { usage; exit 1; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --build) build=true ;;
    --pull) pull=true ;;
    --runtime) runtime=true ;;
    --no-tunnel) tunnel=false ;;
    --dry-run) dry_run=true ;;
    --instance)
      [[ $# -gt 1 ]] || die '--instance needs a name, such as staging'
      instance=$2; shift ;;
    --instance=*) instance=${1#--instance=} ;;
    --no-*)
      app=${1#--no-}
      is_app "$app" || die "unknown app '$app' in $1. Apps: $apps"
      excluded="$excluded $app" ;;
    -*) die "unknown option $1. Try ./launch --help" ;;
    infra|web|all|edge|status|secrets)
      if [[ -z $target ]]; then
        target=$1
      elif [[ $target == stop ]]; then
        stop_target=$1
      else
        die "one target at a time: got '$target' and '$1'"
      fi ;;
    stop)
      [[ -z $target ]] || die "one target at a time: got '$target' and 'stop'"
      target=stop ;;
    *) die "unknown target '$1'. Try ./launch --help" ;;
  esac
  shift
done
[[ -n $target ]] || die 'name a target: infra, web, all, edge, secrets, stop, or status'
[[ $stop_target != status ]] || die "'status' cannot be stopped"
if [[ -n $excluded && $target != web && $target != all ]]; then die '--no-<app> only applies to web and all'; fi
if ! $tunnel && [[ $target != edge ]]; then die '--no-tunnel only applies to edge'; fi
if $pull; then
  $build && die '--pull and --build exclude each other'
  [[ -n ${IMAGE_REGISTRY:-} && -n ${IMAGE_TAG:-} ]] || die '--pull needs IMAGE_REGISTRY and IMAGE_TAG, such as ghcr.io/biotrondesignteam/ and a commit'
fi
if [[ -n $instance ]]; then
  # The name becomes part of project, network, volume, and alias names.
  [[ $instance =~ ^[a-z][a-z0-9]{0,15}$ ]] || die "instance names are a lowercase letter, then up to 15 lowercase letters or digits: got '$instance'"
  case $instance in local|edge|secrets|infrastructure) die "'$instance' is a reserved name" ;; esac
  case "$target:$stop_target" in
    edge:*|secrets:*|stop:edge|stop:secrets) die '--instance applies to infra, web, and all; the edge and Infisical are shared' ;;
  esac
fi

command -v docker >/dev/null 2>&1 || die 'docker is not installed or not on PATH'

# Prints the command, then runs it unless this is a dry run.
run() {
  printf '+'; printf ' %q' "$@"; printf '\n'
  $dry_run || "$@"
}

# Runtime mode also disables Compose's implicit root .env lookup.
if $runtime; then
  export COMPOSE_DISABLE_ENV_FILE=true
fi
# Include env_file does not support required:false. Select existing local
# files explicitly, otherwise use /dev/null so no app file is required.
for app in $apps; do
  env_file=/dev/null
  if ! $runtime && [[ -f apps/$app/.env ]]; then env_file="$root/apps/$app/.env"; fi
  env_key=$(printf '%s' "$app" | tr '[:lower:]' '[:upper:]')
  export "${env_key}_ENV_FILE=$env_file"
done
INFRA_ENV_FILE=/dev/null
if ! $runtime && [[ -f infra/.env ]]; then INFRA_ENV_FILE="$root/infra/.env"; fi
export INFRA_ENV_FILE

# One instance is one Compose project holding its data services and apps.
# The instance name keeps everything two instances on one host could share
# apart: project, network, volumes, the edge's aliases, and host ports, which a
# named instance does not publish at all.
project=biotron network=biotron
stack_files=(-f docker-compose.yml)
if [[ -n $instance ]]; then
  project=biotron-$instance network=biotron-$instance
  stack_files+=(-f infra/no-host-ports.yml)
  export BIOTRON_INSTANCE=$instance
else
  unset BIOTRON_INSTANCE
fi
export BIOTRON_NETWORK=$network

# Every instance network has a fixed subnet, so the edge can hold a fixed
# address on it, .2, and the apps can trust that one address to name the
# client (TRUSTED_PROXIES). Docker hands out the others from the upper half.
# The laptop instance is `local`.
instance_index() {
  case $1 in
    local) echo 0 ;;
    staging) echo 1 ;;
    prod) echo 2 ;;
    *) echo $(( $(printf '%s' "$1" | cksum | cut -d' ' -f1) % 200 + 10 )) ;;
  esac
}
instance_prefix() { echo "10.213.$(instance_index "$1")"; }
export BIOTRON_EDGE_ADDRESS
BIOTRON_EDGE_ADDRESS=$(instance_prefix "${instance:-local}").2
stack_compose() { run docker compose -p "$project" "${stack_files[@]}" "$@"; }
stack_config() { docker compose -p "$project" "${stack_files[@]}" config "$@"; }

# The edge's settings and tunnel token are bootstrap configuration, kept in a
# root-only file outside the checkout. A local infra/edge/.env wins outside
# runtime mode, for testing the edge on a laptop.
edge_env_file=${EDGE_ENV_FILE:-/etc/biotron/edge.env}
if [[ -z ${EDGE_ENV_FILE:-} ]] && ! $runtime && [[ -f infra/edge/.env ]]; then edge_env_file=infra/edge/.env; fi
edge_files=(-f infra/edge/docker-compose.yml)
edge_compose() { run docker compose "${edge_files[@]}" --env-file "$edge_env_file" "$@"; }

# An instance's network. The unnamed laptop instance is `local` to the edge.
instance_network() { if [[ $1 == local ]]; then echo biotron; else echo "biotron-$1"; fi; }

# Nginx joins the network of every instance in EDGE_SITES, so it can reach each
# one while the instances never share a network with each other. The list
# depends on the host, so it goes into a generated override file.
edge_override() {
  command -v jq >/dev/null 2>&1 || die 'jq is required to read EDGE_SITES'
  local sites entry name net
  sites=$(docker compose "${edge_files[@]}" --env-file "$edge_env_file" config --format json |
    jq -r '.services.nginx.environment.EDGE_SITES // ""') || die "cannot read EDGE_SITES from $edge_env_file"
  printf 'services:\n  nginx:\n    networks:\n'
  for entry in $sites; do
    name=${entry%%=*}
    [[ $name =~ ^[a-z][a-z0-9]{0,15}$ ]] || die "EDGE_SITES: invalid instance name '$name'"
    printf '      instance-%s:\n        aliases: [edge-proxy]\n        ipv4_address: %s.2\n' "$name" "$(instance_prefix "$name")"
  done
  printf 'networks:\n'
  for entry in $sites; do
    name=${entry%%=*}
    net=$(instance_network "$name")
    printf '  instance-%s:\n    external: true\n    name: %s\n' "$name" "$net"
  done
}
secrets_compose() {
  run docker compose -f infra/infisical/docker-compose.yml --env-file "${INFISICAL_BOOTSTRAP_FILE:-/etc/biotron/infisical.env}" "$@"
}

# The networks are external to every compose file, so infra, the apps, and the
# edge can start in any order. Creating one is the only state launch adds.
# ensure_network <network> <instance>
ensure_network() {
  local prefix subnet have
  prefix=$(instance_prefix "$2")
  subnet=$prefix.0/24
  if $dry_run || ! have=$(docker network inspect --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}' "$1" 2>/dev/null); then
    local args=(network create "$1" --subnet "$subnet" --ip-range "$prefix.128/25" --gateway "$prefix.1")
    printf '+ docker'; printf ' %q' "${args[@]}"; printf '\n'
    $dry_run || docker "${args[@]}" >/dev/null
  elif [[ $have != "$subnet" ]]; then
    die "the network $1 has the subnet '$have', not $subnet, which the edge's fixed address needs. Stop its containers and the edge, run docker network rm $1, and launch again"
  fi
}

# Check only selected services, without printing the rendered credentials. A
# deployment (--runtime) also needs every app role's password; a laptop whose
# infra/.env predates the roles may leave them out and use the owner's URL.
validate() {
  command -v jq >/dev/null 2>&1 || die 'jq is required to validate configuration'
  stack_config --format json | jq -er --arg selected "$1" --argjson runtime "$runtime" '
    .services as $services |
    ($selected | split("\n"))[] as $name |
    $services[$name].environment as $env |
    if ($env | has("DATABASE_URL")) and (($env.DATABASE_URL // "") == "") then
      error($name + ": set its app-prefixed DATABASE_URL")
    elif $name == "postgres" and ((($env.POSTGRES_PASSWORD // "") == "") or (($env.SPRINTER_READER_PASSWORD // "") == "")) then
      error("postgres: set POSTGRES_PASSWORD and SPRINTER_READER_PASSWORD")
    elif $name == "postgres" and $runtime and
        ([$env.AUTH_DB_PASSWORD, $env.CALENDAR_DB_PASSWORD, $env.STATUS_DB_PASSWORD, $env.SPRINTER_DB_PASSWORD]
         | any((. // "") == "")) then
      error("postgres: set AUTH_DB_PASSWORD, CALENDAR_DB_PASSWORD, STATUS_DB_PASSWORD, and SPRINTER_DB_PASSWORD")
    else true end
  ' >/dev/null
}

# The services of the chosen apps, read from the compose file itself so a new
# service is picked up with no edit here. An app's services share its prefix:
# calendar-migrate, calendar-api, calendar-web.
web_services() {
  local service app skip
  stack_config --services | sort | while read -r service; do
    skip=false
    case " $infra_services " in *" $service "*) skip=true ;; esac
    for app in $excluded; do
      case "$service" in "$app"-*) skip=true ;; esac
    done
    $skip || echo "$service"
  done
}

# Before the data services joined the root project they ran as the
# biotron-infrastructure project on the same volumes. Two Postgres containers
# must never share one data directory.
refuse_old_infra() {
  [[ -z $instance ]] || return 0
  $dry_run && return 0
  if [[ -n $(docker ps -q --filter label=com.docker.compose.project=biotron-infrastructure --filter label=com.docker.compose.service=postgres) ]]; then
    die 'the old biotron-infrastructure project still runs Postgres on these volumes. Stop it first: docker compose -p biotron-infrastructure down'
  fi
}

# Starts services through the given compose function. With --pull it first
# pulls their tagged images and then never builds, which is how a host deploys.
bring_up() {
  local compose=$1
  shift
  local args=(up -d)
  $build && args+=(--build)
  if $pull; then
    "$compose" pull "$@"
    args+=(--no-build)
    # A full deploy also drops containers of services that no longer exist.
    if [[ $target == all ]]; then args+=(--remove-orphans); fi
  fi
  "$compose" "${args[@]}" "$@"
}

start_infra() {
  # shellcheck disable=SC2086
  validate "$(printf '%s\n' $infra_services)"
  refuse_old_infra
  ensure_network "$network" "${instance:-local}"
  # shellcheck disable=SC2086
  bring_up stack_compose $infra_services
}

start_web() {
  local services
  services=$(web_services)
  [[ -n $services ]] || die 'every app was left out, so there is nothing to start'
  validate "$services"
  ensure_network "$network" "${instance:-local}"
  # shellcheck disable=SC2086
  bring_up stack_compose $services
}

start_edge() {
  local services=()
  override=$(mktemp)
  trap 'rm -f "$override"' EXIT
  edge_override > "$override"
  # A dry run shows the generated override too.
  if $dry_run; then sed "s/^/# override: /" "$override"; fi
  local names name
  mapfile -t names < <(sed -n 's/^  instance-\(.*\):$/\1/p' "$override")
  for name in "${names[@]}"; do ensure_network "$(instance_network "$name")" "$name"; done
  edge_files+=(-f "$override")
  $tunnel || services=(nginx)
  bring_up edge_compose "${services[@]}"
}

stop_web() {
  local services
  services=$(web_services)
  # shellcheck disable=SC2086
  [[ -z $services ]] || stack_compose stop $services
}
# shellcheck disable=SC2086
stop_infra() { stack_compose stop $infra_services; }

case "$target" in
  secrets)
    $build && die 'Infisical uses prebuilt images; --build does not apply'
    secrets_compose up -d ;;
  infra) start_infra ;;
  web) start_web ;;
  all) start_infra; start_web ;;
  edge) start_edge ;;
  status) run docker ps -a --filter name=biotron --format 'table {{.Names}}\t{{.Status}}' ;;
  stop)
    # Apps first, so nothing is left talking to a database that has gone.
    case "$stop_target" in
      secrets) secrets_compose stop ;;
      edge) edge_compose stop ;;
      web) stop_web ;;
      infra) stop_infra ;;
      all) stop_web; stop_infra ;;
    esac ;;
esac
