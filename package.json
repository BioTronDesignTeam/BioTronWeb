{
  "name": "biotron",
  "private": true,
  "description": "The BioTron platform: six web tools, the shared component library, and the edge that serves them.",
  "workspaces": [
    "packages/*",
    "apps/*/frontend",
    "apps/*/prisma"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.48.0"
  }
}
