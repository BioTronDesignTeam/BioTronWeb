# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
WEB_PORT=5177

# Calendar URLs remain configurable until the production domains are chosen.
VITE_CALENDAR_API_URL=http://localhost:8083
VITE_CALENDAR_URL=http://localhost:5176

# -----------------------------------------------------------------------------
# Search engines and link previews
# -----------------------------------------------------------------------------
# The public address of this site, with no trailing slash. The build writes it
# into every canonical tag, the sitemap, robots.txt, llms.txt, and the link
# preview image address. Set the real domain on a deployment: the default below
# only suits a local preview, and search engines ignore a localhost canonical.
VITE_SITE_URL=http://localhost:5177

# Optional. The code from Google Search Console's "HTML tag" check. It is a
# public value, not a secret. Leave it blank to verify through DNS instead.
VITE_GOOGLE_SITE_VERIFICATION=
