# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_URL=/api
VITE_IDP_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
OAUTH_MANAGER_URL=http://oauth-manager:8080

# AUTH_DISABLED is deliberately absent from this file and from
# docker-compose.yml. It turns off every read authorization check, so a stray
# value must not be able to reach a deployed container. For isolated local UI
# work, opt in explicitly instead:
#
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up
REDIS_TAIL_SIZE=500

# Peers allowed to set the client address Logger rate limits and logs by.
# The edge proxy rewrites Cf-Connecting-Ip on every hop, so only the loopback
# and the Docker bridge range belong here.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
HEALTH_INTERVAL=15s
HEALTH_HISTORY_INTERVAL=5m
HEALTH_TIMEOUT=3s
LOGGER_CATALOG_JSON=

# Public status routes: in-process cache lifetime and per-address rate limit.
STATUS_CACHE_TTL=30s
STATUS_RATE_LIMIT=60

# Log ingestion requests per minute per sender address. Ten a second, spendable
# as a burst, is far above what any catalogued service emits and far below what
# a leaked ingest token would need to flood the shared Postgres.
INGEST_RATE_LIMIT=600

# -----------------------------------------------------------------------------
# Log ingestion secret
# Every logging client must use the same token.
# -----------------------------------------------------------------------------
LOGGER_INGEST_TOKEN=replace-with-a-long-random-token

# -----------------------------------------------------------------------------
# PostgreSQL
# This repository owns the logger schema in the shared Postgres instance.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=logger

# -----------------------------------------------------------------------------
# Redis
# Logger stores recent log tails and current health state here.
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=8082
WEB_PORT=5175
