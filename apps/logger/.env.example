# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Peers allowed to set the client address Logger rate limits and logs by.
# The edge proxy rewrites Cf-Connecting-Ip on every hop, so only the loopback
# and the Docker bridge range belong here.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
HEALTH_INTERVAL=15s
HEALTH_HISTORY_INTERVAL=5m
HEALTH_TIMEOUT=3s
LOGGER_CATALOG_JSON=

# Public status routes: in-process cache lifetime and per-address rate limit.
STATUS_CACHE_TTL=30s
STATUS_RATE_LIMIT=60

# Logger's own events, the monitor's "Component down" among them, sent to
# Grafana and PostHog when configured; see go/logclient/README.md.
LOG_LEVEL=info
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USER=
GRAFANA_OTLP_TOKEN=
POSTHOG_HOST=
POSTHOG_API_KEY=
BIOTRON_ENV=

# -----------------------------------------------------------------------------
# PostgreSQL
# This repository owns the logger schema in the shared Postgres instance.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=logger

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=8082
WEB_PORT=5175
