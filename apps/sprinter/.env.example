# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8084
VITE_AUTH_URL=http://localhost:8080
VITE_CALENDAR_URL=http://localhost:8083

# -----------------------------------------------------------------------------
# Discord
# An empty token runs the admin API with no gateway session.
# -----------------------------------------------------------------------------
DISCORD_TOKEN=
# The one guild the commands are registered in. Required when the token is set.
DISCORD_GUILD_ID=

# -----------------------------------------------------------------------------
# Model
# An empty key runs the echo runner: the commands work, the answers do not.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Backend integrations and secrets
# -----------------------------------------------------------------------------
CALENDAR_URL=http://calendar-api:8080
# How many questions one /agent-thread conversation answers before it is full.
THREAD_MAX_TURNS=40
# How long one question may take, tool calls included.
AGENT_TIMEOUT=2m
# How often the scheduler reads Calendar for announcements and nudges.
POLL_INTERVAL=5m
# Where the admin API checks the sprinter/admin permission.
OAUTH_MANAGER_URL=http://oauth-manager:8080
# Structured application logs. Use the same ingestion token as Logger.
LOGGER_URL=http://logger-api:8080
LOGGER_INGEST_TOKEN=

# -----------------------------------------------------------------------------
# Admin API
# -----------------------------------------------------------------------------
# The admin UI's origin. It may always make credentialed requests.
FRONTEND_URL=http://localhost:5178
# Extra origins that may. List each host as localhost and 127.0.0.1.
CORS_ORIGINS=http://localhost:5178,http://127.0.0.1:5178
# Only these peers may set the client-IP header. Edge Nginx is the only one.
TRUSTED_PROXIES=127.0.0.1,::1

# -----------------------------------------------------------------------------
# PostgreSQL
# This repository owns the sprinter schema in the shared Postgres instance.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=sprinter
# A read-only role for the agent's tools. Empty leaves out the four SQL tools.
READ_DATABASE_URL=postgresql://sprinter_reader:change-me-reader@postgres:5432/biotron

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=8084
WEB_PORT=5178
