# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8083
VITE_AUTH_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5176
SITE_URL=http://localhost:5177
# Feed URLs use VITE_API_URL, resolving /api against FRONTEND_URL in production.
# Set PUBLIC_BASE_URL only when subscribers must use a different API address.
# PUBLIC_BASE_URL=https://calendar.uwbiotron.dev/api
OAUTH_MANAGER_URL=http://oauth-manager:8080
# FRONTEND_URL is already allowed in both lists; SITE_URL in the public list.
CORS_ORIGINS=http://127.0.0.1:5176,http://127.0.0.1:5177
ADMIN_CORS_ORIGINS=http://127.0.0.1:5176
DEFAULT_TIMEZONE=America/Toronto
MAX_RANGE_DAYS=370

# Structured application logs, sent to Grafana and PostHog when configured;
# see go/logclient/README.md. Without either, events go nowhere.
LOG_LEVEL=info
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USER=
GRAFANA_OTLP_TOKEN=
POSTHOG_HOST=
POSTHOG_API_KEY=
BIOTRON_ENV=

# -----------------------------------------------------------------------------
# PostgreSQL
# This repository owns the calendar schema in the shared Postgres instance.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=calendar # trufflehog:ignore

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=8083
WEB_PORT=5176
