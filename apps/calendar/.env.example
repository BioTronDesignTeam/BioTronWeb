# Copy this file to .env beside it. ./launch reads it; plain docker compose
# run from the repository root does not.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8083
VITE_AUTH_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5176
SITE_URL=http://localhost:5177
# Feed URLs use VITE_API_URL, resolving /api against FRONTEND_URL in production.
# Set PUBLIC_BASE_URL only when subscribers must use a different API address.
# PUBLIC_BASE_URL=https://calendar.uwbiotron.dev/api
OAUTH_MANAGER_URL=http://oauth-manager:8080
# FRONTEND_URL is already allowed in both lists; SITE_URL in the public list.
# The 127.0.0.1 forms of the two above, and Sprinter's admin page, which reads
# the scope list.
CORS_ORIGINS=http://127.0.0.1:5176,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178
ADMIN_CORS_ORIGINS=http://127.0.0.1:5176
DEFAULT_TIMEZONE=America/Toronto
MAX_RANGE_DAYS=370

# Structured application logs, sent to Grafana and PostHog when configured;
# see go/logclient/README.md. Without either, events go nowhere.
LOG_LEVEL=info
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USER=
GRAFANA_OTLP_TOKEN=
POSTHOG_HOST=
POSTHOG_API_KEY=
BIOTRON_ENV=

# -----------------------------------------------------------------------------
# PostgreSQL
# This app owns the calendar schema in its instance's Postgres. The API connects
# as calendar_app, with rights in that schema only; migrations run as the owner,
# biotron. The passwords are the ones in infra/.env. See
# infra/postgres/init/05-app-roles.sh.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://calendar_app:change-me-calendar@postgres:5432/biotron?schema=calendar # trufflehog:ignore
MIGRATE_DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=calendar # trufflehog:ignore

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=8083
WEB_PORT=5176
