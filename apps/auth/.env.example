# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_BASE=http://localhost:8080

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
OAUTH_CALLBACK_URL=http://localhost:8080/auth/github/callback
CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://127.0.0.1:5177,http://127.0.0.1:5178
# false is correct only for plain-http localhost. The backend refuses to start
# with COOKIE_SECURE=false once OAUTH_CALLBACK_URL is https or COOKIE_DOMAIN is
# set, so a deployment cannot silently ship a session cookie without Secure.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# Leave blank on localhost. Use the shared parent domain after deployment, e.g. .biotron.ca.
COOKIE_DOMAIN=
SESSION_TTL_HOURS=168
# The peers whose Cf-Connecting-Ip names the client, for every per-IP rate
# limit and log line: loopback, and the edge, which ./launch gives the fixed
# address .2 on each instance network (10.213.0.2 on a laptop's `biotron`).
# Anyone else's header is ignored. SAFE ONLY BECAUSE
# infra/nginx/snippets/proxy-headers.conf sets Cf-Connecting-Ip itself. Never
# list a whole Docker range here.
TRUSTED_PROXIES=127.0.0.1,::1,10.213.0.2

# Structured application logs, sent to Grafana and PostHog when configured;
# see go/logclient/README.md. Without either, events go nowhere.
LOG_LEVEL=info
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USER=
GRAFANA_OTLP_TOKEN=
POSTHOG_HOST=
POSTHOG_API_KEY=
BIOTRON_ENV=

# -----------------------------------------------------------------------------
# GitHub App and authorization secrets. README.md, "The GitHub App", says how
# to create the App. The backend refuses to start without the App's four values
# and a session signing key.
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The .pem, in double quotes across its lines, or on one line with \n breaks.
GITHUB_APP_PRIVATE_KEY=
# Signs the session cookie. At least 32 characters, one per environment:
#   openssl rand -base64 48
# A new value signs everyone out.
SESSION_SIGNING_KEY=
GITHUB_ORG=BioTronDesignTeam
SUPERUSER_GITHUB_IDS=

# -----------------------------------------------------------------------------
# PostgreSQL
# This app owns the oauth schema in its instance's Postgres. The API connects
# as auth_app, with rights in that schema only; migrations run as the owner,
# biotron. The passwords are the ones in infra/.env. See
# infra/postgres/init/05-app-roles.sh.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://auth_app:change-me-auth@postgres:5432/biotron?schema=oauth # trufflehog:ignore
MIGRATE_DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=oauth # trufflehog:ignore

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=8080
WEB_PORT=5173
