# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_BASE=http://localhost:8080

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
OAUTH_CALLBACK_URL=http://localhost:8080/auth/github/callback
CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://127.0.0.1:5177,http://127.0.0.1:5178
# false is correct only for plain-http localhost. The backend refuses to start
# with COOKIE_SECURE=false once OAUTH_CALLBACK_URL is https or COOKIE_DOMAIN is
# set, so a deployment cannot silently ship a session cookie without Secure.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# Leave blank on localhost. Use the shared parent domain after deployment, e.g. .biotron.ca.
COOKIE_DOMAIN=
SESSION_TTL_HOURS=168
# nginx reaches the API from the shared `biotron` bridge network, not from
# loopback, so the edge must be inside this list or the API ignores
# Cf-Connecting-Ip and keys every per-IP rate limit into one global bucket.
# 172.16.0.0/12 is Docker's default bridge pool; narrow it to the exact
# `biotron` subnet once that network is given a fixed one.
# SAFE ONLY BECAUSE Server/nginx/snippets/proxy-headers.conf sets
# Cf-Connecting-Ip itself. Do not widen this list in an environment whose edge
# does not.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Structured application logs. Use the same ingestion token as Logger.
LOGGER_URL=http://logger-api:8080
LOGGER_INGEST_TOKEN=
LOG_LEVEL=info
# Optional log destinations beside Logger; see go/logclient/README.md.
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USER=
GRAFANA_OTLP_TOKEN=
POSTHOG_HOST=
POSTHOG_API_KEY=
BIOTRON_ENV=

# -----------------------------------------------------------------------------
# GitHub App and authorization secrets. README.md, "The GitHub App", says how
# to create the App. The backend refuses to start without the App's four values
# and a session signing key.
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The .pem, in double quotes across its lines, or on one line with \n breaks.
GITHUB_APP_PRIVATE_KEY=
# Signs the session cookie. At least 32 characters, one per environment:
#   openssl rand -base64 48
# A new value signs everyone out.
SESSION_SIGNING_KEY=
GITHUB_ORG=BioTronDesignTeam
SUPERUSER_GITHUB_IDS=

# -----------------------------------------------------------------------------
# PostgreSQL
# This repository owns the oauth schema in the shared Postgres instance.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=oauth

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=8080
WEB_PORT=5173
