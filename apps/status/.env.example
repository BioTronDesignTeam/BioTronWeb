# Copy this file to .env. ./launch reads it, as does `docker compose` run in this folder.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Peers allowed to set the client address Status rate limits and logs by:
# loopback, and the edge's fixed address on the instance network (10.213.0.2
# on a laptop; see infra/README.md). The edge rewrites Cf-Connecting-Ip itself.
TRUSTED_PROXIES=127.0.0.1,::1,10.213.0.2
HEALTH_INTERVAL=15s
HEALTH_HISTORY_INTERVAL=5m
HEALTH_TIMEOUT=3s
STATUS_CATALOG_JSON=

# Public status routes: in-process cache lifetime and per-address rate limit.
STATUS_CACHE_TTL=30s
STATUS_RATE_LIMIT=60

# Status's own events, the monitor's "Component down" among them, sent to
# Grafana and PostHog when configured; see go/logclient/README.md.
LOG_LEVEL=info
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USER=
GRAFANA_OTLP_TOKEN=
POSTHOG_HOST=
POSTHOG_API_KEY=
BIOTRON_ENV=

# -----------------------------------------------------------------------------
# PostgreSQL
# This app owns the logger schema in its instance's Postgres. The API connects
# as status_app, with rights in that schema only; migrations run as the owner,
# biotron. The passwords are the ones in infra/.env. See
# infra/postgres/init/05-app-roles.sh.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://status_app:change-me-status@postgres:5432/biotron?schema=logger # trufflehog:ignore
MIGRATE_DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=logger # trufflehog:ignore

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=8082
WEB_PORT=5175
