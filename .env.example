# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:18084
VITE_AUTH_URL=http://localhost:18080
VITE_SITE_URL=http://localhost:18083

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5176
SITE_URL=http://localhost:18083
PUBLIC_BASE_URL=http://localhost:18084
OAUTH_MANAGER_URL=http://oauth-manager:8080
CORS_ORIGINS=http://127.0.0.1:5176,http://127.0.0.1:18083
ADMIN_CORS_ORIGINS=http://127.0.0.1:5176
DEFAULT_TIMEZONE=America/Toronto
MAX_RANGE_DAYS=370
TRUSTED_PROXIES=127.0.0.1,::1

# Structured application logs. Use the same ingestion token as Logger.
LOGGER_URL=http://logger-api:8080
LOGGER_INGEST_TOKEN=
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL
# This repository owns the calendar schema in the shared Postgres instance.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=calendar

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=18084
WEB_PORT=5176
