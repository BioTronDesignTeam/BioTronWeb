# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:18082

# -----------------------------------------------------------------------------
# PostgreSQL
# This repository owns the calendar schema in the shared Postgres instance.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=calendar

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=18082
WEB_PORT=5172
