# Copy this file to .env. Docker Compose reads it from the repository root.

# -----------------------------------------------------------------------------
# Public frontend configuration
# These values are compiled into the browser bundle. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_BASE=http://localhost:18080

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
OAUTH_CALLBACK_URL=http://localhost:18080/auth/github/callback
CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5176
CACHE_TTL_SECONDS=300
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# Leave blank on localhost. Use the shared parent domain after deployment, e.g. .biotron.ca.
COOKIE_DOMAIN=
SESSION_TTL_HOURS=168
TRUSTED_PROXIES=127.0.0.1,::1

# Structured application logs. Use the same ingestion token as Logger.
LOGGER_URL=http://logger-api:8080
LOGGER_INGEST_TOKEN=
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# GitHub OAuth and authorization secrets
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=BioTronDesignTeam
SUPERUSER_GITHUB_IDS=

# -----------------------------------------------------------------------------
# PostgreSQL
# This repository owns the oauth schema in the shared Postgres instance.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://biotron:change-me@postgres:5432/biotron?schema=oauth

# -----------------------------------------------------------------------------
# Redis
# OAuthManager uses Redis for grant-set lookup caching. Session and role truth
# remains in PostgreSQL so permission changes are not sticky.
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Host port overrides
# -----------------------------------------------------------------------------
API_PORT=18080
WEB_PORT=5173
