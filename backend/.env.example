# Copy to backend/.env (gitignored) for local use outside the dev container.
# Inside the dev container, DATABASE_URL is provided by docker-compose.

# Postgres
DATABASE_URL="postgresql://exo:exo@db:5432/exo?schema=public"

# GitHub OAuth App (register one under the BioTronDesignTeam org).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_ORG="BioTronDesignTeam"

# Must exactly match the OAuth App's "Authorization callback URL".
OAUTH_CALLBACK_URL="http://localhost:8080/auth/github/callback"

# SPA origin: post-login redirect target AND the allowed CORS origin.
FRONTEND_URL="http://localhost:5173"

# Session cookie attributes.
# Local dev (http, same-site localhost): Lax + non-secure (defaults below).
# Production (Netlify <-> api. is cross-site over HTTPS): COOKIE_SECURE=true, COOKIE_SAMESITE=None
COOKIE_SECURE="false"
COOKIE_SAMESITE="Lax"

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS="168"

# HTTP port.
PORT="8080"
