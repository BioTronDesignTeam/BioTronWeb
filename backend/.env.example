# Copy to backend/.env (gitignored) for local use.

# Postgres (matches docker-compose.yml — host port 5434)
DATABASE_URL="postgresql://oauth:oauth@127.0.0.1:5434/oauth?schema=public"

# Redis session + grant cache
REDIS_URL="redis://127.0.0.1:6379/0"
CACHE_TTL_SECONDS="300"

# GitHub OAuth App (register under the BioTronDesignTeam org).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_ORG="BioTronDesignTeam"

# Must exactly match the OAuth App's Authorization callback URL.
OAUTH_CALLBACK_URL="http://localhost:8080/auth/github/callback"

# Default post-login redirect + first CORS origin (this app's UI).
FRONTEND_URL="http://localhost:5173"
# Extra tool UIs allowed to call this API and return here after GitHub login.
# Example: http://localhost:5174 for exo-gui when both SPAs are running.
CORS_ORIGINS=""

COOKIE_SECURE="false"
COOKIE_SAMESITE="Lax"
SESSION_TTL_HOURS="168"

# Comma-separated GitHub user IDs that are superusers. Authoritative on every
# login: listed → is_superuser=true, omitted → cleared. Managers are separate
# (Org UI). Restart alone does not demote — sign out/in after changing this.
SUPERUSER_GITHUB_IDS=""

PORT="8080"
TRUSTED_PROXIES="127.0.0.1,::1"
